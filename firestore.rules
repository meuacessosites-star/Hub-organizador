rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 4: Fortress Rules
    match /usuarios/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUsuario(incoming());
      allow delete: if isOwner(userId);

      function isValidUsuario(data) {
        return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
          && (!('email' in data) || (data.email is string && data.email.size() <= 256))
          && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1048576))
          && (!('origem_app' in data) || (data.origem_app is string && data.origem_app.size() <= 128))
          && (!('origem' in data) || (data.origem is string && data.origem.size() <= 128))
          && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
          && (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 128))
          && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp || data.lastLoginAt == null)
          && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128) || data.updatedAt is timestamp);
      }
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                      && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar']);

      function isValidUser(data) {
        return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
          && (!('avatar' in data) || (data.avatar is map 
            && data.avatar.type is string && data.avatar.type.size() <= 32
            && data.avatar.value is string && data.avatar.value.size() <= 1048576
            && (!('bgColor' in data.avatar) || (data.avatar.bgColor is string && data.avatar.bgColor.size() <= 20))));
      }

      // Subcollections
      match /tags/{tagId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(tagId) && isValidTag(incoming());
        allow delete: if isOwner(userId);

        function isValidTag(data) {
          return data.keys().hasAll(['id', 'name', 'emoji', 'color'])
            && data.id == tagId
            && data.name is string && data.name.size() <= 64
            && data.emoji is string && data.emoji.size() <= 32
            && data.color is string && data.color.size() <= 20;
        }
      }

      match /categories/{categoryId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(categoryId) && isValidCategory(incoming());
        allow delete: if isOwner(userId);

        function isValidCategory(data) {
          return data.keys().hasAll(['id', 'name', 'icon', 'color'])
            && data.id == categoryId
            && data.name is string && data.name.size() <= 64
            && data.icon is string && data.icon.size() <= 64
            && data.color is string && data.color.size() <= 20
            && (!('isCustom' in data) || data.isCustom is bool);
        }
      }

      match /platforms/{platformId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(platformId) && isValidPlatform(incoming());
        allow delete: if isOwner(userId);

      function isValidPlatform(data) {
        return data.keys().hasAll(['id', 'name'])
          && data.id == platformId
          && data.name is string && data.name.size() <= 128
          && (!('url' in data) || (data.url is string && data.url.size() <= 512))
          && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1048576))
          && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128))
          && (!('profiles' in data) || (data.profiles is list && data.profiles.size() <= 100))
          && (!('purchases' in data) || (data.purchases is list && data.purchases.size() <= 1000))
          && (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128));
      }
      }

      match /statuses/{statusId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(statusId) && isValidStatus(incoming());
        allow delete: if isOwner(userId);

        function isValidStatus(data) {
          return data.keys().hasAll(['id', 'label', 'color'])
            && data.id == statusId
            && data.label is string && data.label.size() <= 64
            && data.color is string && data.color.size() <= 20
            && (!('icon' in data) || (data.icon is string && data.icon.size() <= 64))
            && (!('isCustom' in data) || data.isCustom is bool);
        }
      }

      match /profilePresets/{presetId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(presetId) && isValidPreset(incoming());
        allow delete: if isOwner(userId);

        function isValidPreset(data) {
          return data.keys().hasAll(['id', 'name'])
            && data.id == presetId
            && data.name is string && data.name.size() <= 128
            && (!('email' in data) || (data.email is string && data.email.size() <= 256))
            && (!('username' in data) || (data.username is string && data.username.size() <= 256))
            && (!('password' in data) || (data.password is string && data.password.size() <= 512))
            && (!('accessLink' in data) || (data.accessLink is string && data.accessLink.size() <= 1024))
            && (!('description' in data) || (data.description is string && data.description.size() <= 2048))
            && (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128));
        }
      }
    }
  }
}
