{
  "entities": {
    "Usuario": {
      "title": "Usuario",
      "description": "Dados do perfil de usuario e origem do app",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "origem_app": { "type": "string" },
        "origem": { "type": "string" },
        "lastLogin": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "origem_app"]
    },
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "avatar": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "value": { "type": "string" },
            "bgColor": { "type": "string" }
          },
          "required": ["type", "value"]
        }
      }
    },
    "Tag": {
      "title": "Tag",
      "description": "Custom tags for organizing platforms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "emoji", "color"]
    },
    "Category": {
      "title": "Category",
      "description": "Platform categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "name", "icon", "color"]
    },
    "Platform": {
      "title": "Platform",
      "description": "Platform credentials and data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "logoUrl": { "type": "string" },
        "categoryId": { "type": "string" },
        "profiles": { "type": "array" },
        "purchases": { "type": "array" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Status": {
      "title": "Status",
      "description": "Purchase status options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "label", "color"]
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": "Usuario",
      "description": "Colecao principal de usuarios com registro de origem do app"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Main user document"
    },
    "/users/{userId}/tags/{tagId}": {
      "schema": "Tag",
      "description": "User custom tags"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User custom categories"
    },
    "/users/{userId}/platforms/{platformId}": {
      "schema": "Platform",
      "description": "User platforms and accounts"
    },
    "/users/{userId}/statuses/{statusId}": {
      "schema": "Status",
      "description": "User custom purchase statuses"
    }
  }
}
